# Copy to .env and fill in the keys you actually use.
# The JSONL under runs/ is always written; hosted models need at least one of these.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Hugging Face Hub (gated models / dataset rate limits)
HF_TOKEN=

# Optional experiment tracking. Leave unset to keep W&B off.
WANDB_API_KEY=
WANDB_ENTITY=
